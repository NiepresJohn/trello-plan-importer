# Trello credentials (required) - get them at https://trello.com/app-key
TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Optional access gate. If set, the same value must also be exposed to the
# browser as NEXT_PUBLIC_WEBHOOK_SECRET (so it is NOT truly secret; use real
# auth / a reverse proxy for public deployments). Leave both empty for local use.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
NEXT_PUBLIC_WEBHOOK_SECRET=

# Optional defaults
DEFAULT_BOARD_ID=
DEFAULT_LIST_NAME=To Do
ALLOW_BOARD_CREATE=true
ALLOW_LABEL_CREATE=true
RATE_LIMIT_PER_MINUTE=30
